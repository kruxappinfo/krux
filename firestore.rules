rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    function isNumber(field) {
      return field is number;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Allow owner full write, OR allow any authenticated user to update stats or savedPosts
      allow update: if isOwner(userId) || 
                      (isAuthenticated() && 
                       (onlyStatsChanged() || onlySavedPostsChanged()));
      allow delete: if isOwner(userId);
      
      // Helper to check if only stats fields are being modified
      function onlyStatsChanged() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasOnly(['stats']) || 
               changedKeys.hasOnly(['stats.followersCount']) ||
               changedKeys.hasOnly(['stats.followingCount']) ||
               changedKeys.hasOnly(['stats.followersCount', 'stats.followingCount']);
      }
      
      // Helper to check if only savedPosts field is being modified (for bookmarks)
      function onlySavedPostsChanged() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasOnly(['savedPosts']);
      }

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
      
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }

      match /ascents/{ascentId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /following/{followedUserId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
      
      match /followers/{followerUserId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && request.auth.uid == followerUserId;
      }
      
      match /notifications/{notificationId} {
        // Allow read: owner can read all, others can only read notifications they created
        // Note: For non-existent docs, resource.data is null, so we check notificationId pattern
        allow read: if isOwner(userId) ||
                      (isAuthenticated() &&
                       (resource == null || resource.data.fromUserId == request.auth.uid));
        // Allow update only for owner
        allow update: if isOwner(userId);
        // Allow delete: owner OR creator (check resource.data.fromUserId)
        allow delete: if isOwner(userId) ||
                        (isAuthenticated() && resource.data.fromUserId == request.auth.uid);
        // Allow create: any authenticated user can create for others
        // The notificationId contains the creator's uid for idempotency
        allow create: if isAuthenticated() &&
                        request.resource.data.fromUserId == request.auth.uid;
      }

      // ───────── Entrena: plan activo (un único documento 'active') ─────────
      match /training_plan/{planId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && planId == 'active'
          && isString(request.resource.data.name, 80)
          && request.resource.data.weeks is int
          && request.resource.data.weeks >= 1 && request.resource.data.weeks <= 16
          && request.resource.data.activeDays is list
          && request.resource.data.activeDays.size() == 7
          && request.resource.data.sessions is list
          && request.resource.data.sessions.size() <= 7;
      }

      // ───────── Entrena: planes (varios por usuario) ─────────
      // El plan activo no es un campo del plan: lo marca training_state/current.activePlanId.
      match /training_plans/{planId} {
        function statePath() { return /databases/$(database)/documents/users/$(userId)/training_state/current; }

        function validPlan(d) {
          return d.keys().hasOnly(['schemaVersion', 'name', 'status', 'weeks', 'activeDays', 'sessions', 'goal', 'level',
                                   'equipment', 'minutes', 'revision', 'sourcePlanId', 'migratedFrom', 'createdAt',
                                   'updatedAt', 'archivedAt', 'trashedAt', 'trashedFrom', 'startDate'])
            && d.keys().hasAll(['schemaVersion', 'name', 'status', 'weeks', 'activeDays', 'sessions', 'revision', 'createdAt', 'updatedAt'])
            && d.schemaVersion == 2
            && isString(d.name, 80) && d.name.size() > 0
            && d.weeks is int && d.weeks >= 1 && d.weeks <= 16
            && d.activeDays is list && d.activeDays.size() == 7
            && d.sessions is list && d.sessions.size() <= 7
            && d.status in ['ready', 'archived', 'trashed']
            && d.revision is int && d.revision >= 1
            && d.get('equipment', []) is list && d.get('equipment', []).size() <= 10
            && (!('level' in d) || (d.level is int && d.level >= 1 && d.level <= 3))
            // Inicio programado: «AAAA-MM-DD» o null (mes y día posibles; el 29 de febrero de un año no bisiesto lo descarta el cliente)
            && (!('startDate' in d) || d.startDate == null
                || (d.startDate is string && d.startDate.size() == 10 && d.startDate.matches('^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))$')));
        }

        // Un plan que deja de estar «ready» no puede seguir siendo el activo tras la escritura (se
        // comprueba con el estado POSTERIOR: el puntero se vacía en el mismo lote)
        function notActiveAfter() {
          return !existsAfter(statePath()) || getAfter(statePath()).data.get('activePlanId', null) != planId;
        }

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && validPlan(request.resource.data)
          && request.resource.data.status == 'ready'
          && request.resource.data.revision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Cada guardado sube la revisión exactamente 1: una edición con una revisión antigua se rechaza
        allow update: if isOwner(userId)
          && validPlan(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.get('sourcePlanId', null) == resource.data.get('sourcePlanId', null)
          && request.resource.data.get('migratedFrom', null) == resource.data.get('migratedFrom', null)
          && (request.resource.data.status == 'ready' || notActiveAfter());

        // Borrado definitivo: solo desde la papelera
        allow delete: if isOwner(userId)
          && resource.data.status == 'trashed'
          && notActiveAfter();
      }

      // ───────── Entrena: perfil del escalador y evaluación mental (datos personales: solo el propietario) ─────────
      // Nunca son legibles por otros usuarios ni por seguidores. El perfil puede estar a medias mientras se rellena.
      match /training_profile/{docId} {
        function sportGradeOk(g) { return g is string && (g == 'unknown' || g.matches('^[4-9][abc]\\+?$')); }
        function boulderGradeOk(g) { return g is string && (g == 'unknown' || g.matches('^[3-9]([ABC]\\+?|\\+)?$')); }
        function scaleOk(s, boulder) {
          return s is map && s.keys().hasOnly(['usualFrom', 'usualTo', 'max', 'target'])
            && (!('usualFrom' in s) || (boulder ? boulderGradeOk(s.usualFrom) : sportGradeOk(s.usualFrom)))
            && (!('usualTo' in s) || (boulder ? boulderGradeOk(s.usualTo) : sportGradeOk(s.usualTo)))
            && (!('max' in s) || (boulder ? boulderGradeOk(s.max) : sportGradeOk(s.max)))
            && (!('target' in s) || (boulder ? boulderGradeOk(s.target) : sportGradeOk(s.target)));
        }
        function validProfile(d) {
          return d.keys().hasOnly(['schemaVersion', 'status', 'step', 'goalPrimary', 'goalsSecondary', 'experience', 'daysPerWeek',
                                   'minutesPerSession', 'modality', 'environment', 'rockFrequency', 'rockPriority', 'equipment',
                                   'equipmentOther', 'grades', 'updatedAt', 'completedAt'])
            && d.keys().hasAll(['schemaVersion', 'status', 'updatedAt'])
            && d.schemaVersion == 1
            && d.status in ['in_progress', 'completed', 'skipped']
            && d.updatedAt == request.time
            && (!('completedAt' in d) || d.completedAt is timestamp)
            && (!('step' in d) || (d.step is int && d.step >= 1 && d.step <= 6))
            && (!('goalPrimary' in d) || d.goalPrimary in ['grado', 'fuerza', 'resistencia', 'tecnica', 'competicion', 'forma'])
            && (!('goalsSecondary' in d) || (d.goalsSecondary is list && d.goalsSecondary.size() <= 2
                  && d.goalsSecondary.hasOnly(['grado', 'fuerza', 'resistencia', 'tecnica', 'competicion', 'forma'])
                  && d.goalsSecondary.toSet().size() == d.goalsSecondary.size()            // sin repetidos
                  && (!('goalPrimary' in d) || !(d.goalPrimary in d.goalsSecondary))))      // distinto del principal
            && (!('experience' in d) || d.experience in ['lt1', '1-2', '2-4', 'gt4'])
            && (!('daysPerWeek' in d) || (d.daysPerWeek is int && d.daysPerWeek >= 1 && d.daysPerWeek <= 7))
            && (!('minutesPerSession' in d) || (d.minutesPerSession is int && d.minutesPerSession >= 20 && d.minutesPerSession <= 240))
            && (!('modality' in d) || d.modality in ['deportiva', 'bloque', 'ambas'])
            && (!('environment' in d) || d.environment in ['rocodromo', 'roca', 'ambos'])
            // La frecuencia en roca y la prioridad solo existen si escala en ambos entornos
            && (!('rockFrequency' in d) || (d.get('environment', null) == 'ambos' && d.rockFrequency is int && d.rockFrequency >= 1 && d.rockFrequency <= 7))
            && (!('rockPriority' in d) || (d.get('environment', null) == 'ambos' && d.rockPriority in ['roca', 'rocodromo', 'ninguna']))
            && (!('equipment' in d) || (d.equipment is list && d.equipment.size() <= 6
                  && d.equipment.hasOnly(['ninguno', 'multipresa', 'gimnasio', 'bandas', 'pesas', 'otro'])
                  && d.equipment.toSet().size() == d.equipment.size()                      // sin repetidos
                  && (!('ninguno' in d.equipment) || d.equipment.size() == 1)))            // «Ninguno» es excluyente
            && (!('equipmentOther' in d) || (isString(d.equipmentOther, 60) && 'equipment' in d && 'otro' in d.equipment))
            && (!('grades' in d) || (d.grades is map && d.grades.keys().hasOnly(['sport', 'boulder'])
                  && (!('sport' in d.grades) || scaleOk(d.grades.sport, false))
                  && (!('boulder' in d.grades) || scaleOk(d.grades.boulder, true))))
            // Un perfil «completed» trae todo lo imprescindible («No lo sé» cuenta como respuesta en los grados)
            && (d.status != 'completed' || (
                  d.keys().hasAll(['goalPrimary', 'experience', 'daysPerWeek', 'minutesPerSession', 'modality', 'environment', 'equipment', 'completedAt', 'grades'])
                  && d.equipment.size() >= 1
                  && (d.environment != 'ambos' || 'rockFrequency' in d)
                  && (d.modality == 'bloque' || ('sport' in d.grades && d.grades.sport.keys().hasAll(['usualFrom', 'max', 'target'])))
                  && (d.modality == 'deportiva' || ('boulder' in d.grades && d.grades.boulder.keys().hasAll(['usualFrom', 'max', 'target'])))));
        }
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && docId == 'current' && validProfile(request.resource.data);
      }

      match /mental_profile/{docId} {
        function answerOk(a, k) { return !(k in a) || a[k] in [1, 2, 3, 4, 5, 'unknown', 'skip']; }
        function validMental(d) {
          return d.keys().hasOnly(['schemaVersion', 'answers', 'updatedAt'])
            && d.keys().hasAll(['schemaVersion', 'answers', 'updatedAt'])
            && d.schemaVersion == 1
            && d.updatedAt == request.time
            && d.answers is map
            && d.answers.keys().hasOnly(['fear', 'confidence', 'focus', 'frustration', 'pressure'])
            && answerOk(d.answers, 'fear') && answerOk(d.answers, 'confidence') && answerOk(d.answers, 'focus')
            && answerOk(d.answers, 'frustration') && answerOk(d.answers, 'pressure');
        }
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && docId == 'current' && validMental(request.resource.data);
      }

      match /training_state/{docId} {
        allow read: if isOwner(userId);
        // El puntero solo puede apuntar (tras la escritura) a un plan existente y «ready»
        allow create, update: if isOwner(userId)
          && docId == 'current'
          && request.resource.data.keys().hasOnly(['activePlanId', 'migratedAt', 'migratedFrom', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.get('activePlanId', null) == null
              || (request.resource.data.activePlanId is string
                  && existsAfter(/databases/$(database)/documents/users/$(userId)/training_plans/$(request.resource.data.activePlanId))
                  && getAfter(/databases/$(database)/documents/users/$(userId)/training_plans/$(request.resource.data.activePlanId)).data.status == 'ready'));
        allow delete: if false;
      }

      // ───────── Entrena: sesiones realizadas ─────────
      match /training_sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && isString(request.resource.data.dateKey, 10)
          && isString(request.resource.data.sessionName, 80)
          && isNumber(request.resource.data.durationSec)
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() <= 30;
        // Tras crearla solo se añade el registro final (sensaciones, RPE, notas, etiquetas)
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feel', 'rpe', 'notes', 'tags'])
          && isString(request.resource.data.get('notes', ''), 1000)
          && request.resource.data.get('tags', []) is list
          && request.resource.data.get('tags', []).size() <= 10;
      }

      // ───────── Entrena: ejercicios favoritos (solo la referencia, nunca la ficha) ─────────
      match /exercise_favorites/{exerciseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && exerciseId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && request.resource.data.exerciseId == exerciseId;
      }

      // ───────── Test Definitions ─────────
      match /test_definitions/{testId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isString(request.resource.data.name, 100)
          && isString(request.resource.data.templateKey, 50)
          && request.resource.data.unit in ['kg', 'mm', 'seconds', 'reps', 'percent_bw', 'grade', 'custom']
          && request.resource.data.progressDirection in ['higher_is_better', 'lower_is_better']
          && request.resource.data.pinned is bool
          && isNumber(request.resource.data.order)
          && request.resource.data.requiredContext is list;

        allow update: if isOwner(userId)
          && (!('enabledAt' in request.resource.data.diff(resource.data).affectedKeys()));

        allow delete: if isOwner(userId);
      }

      // ───────── Test Measurements ─────────
      match /test_measurements/{measurementId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isString(request.resource.data.testId, 100)
          && isNumber(request.resource.data.value)
          && request.resource.data.measuredAt is timestamp
          && request.resource.data.measuredAt <= request.time;

        allow update: if isOwner(userId)
          && isNumber(request.resource.data.value)
          && request.resource.data.testId == resource.data.testId;

        allow delete: if isOwner(userId);
      }
    }

    match /ascents/{ascentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /comments/{commentId} {
      allow read: if true; // Anyone can read comments
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; // Users can create their own comments
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid; // Users can update their own comments
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid; // Users can delete their own comments
    }

    match /route-photos/{photoId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Posts collection - allows authenticated users to create posts and update likes/commentsCount
    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      allow create: if isAuthenticated(); // Any authenticated user can create posts
      // Allow owner to update/delete, OR allow any authenticated user to update likes/commentsCount
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || // Owner can update anything
        onlyLikesOrCommentsChanged() // Anyone can update likes/commentsCount
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Helper to check if only likes or commentsCount fields are being modified
      function onlyLikesOrCommentsChanged() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasOnly(['likes']) || 
               changedKeys.hasOnly(['commentsCount']) ||
               changedKeys.hasOnly(['likes', 'commentsCount']);
     }
// Comments subcollection - allow comment author to edit, comment/post author to delete
      match /comments/{commentId} {
        allow read: if true; // Anyone can read comments
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        // Allow update if: comment author (full edit) OR any authenticated user (likes/repliesCount)
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || // Author can update anything
          onlyCommentInteractionChanged() // Anyone can update likes or repliesCount
        );
        // Allow delete if user is comment author OR post author
        allow delete: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid ||
                        get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);

        // Helper to check if only likes or repliesCount fields are being modified
        function onlyCommentInteractionChanged() {
          let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
          return changedKeys.hasOnly(['likes']) ||
                 changedKeys.hasOnly(['repliesCount']) ||
                 changedKeys.hasOnly(['likes', 'repliesCount']);
        }

        // Replies subcollection - nested comments
        match /replies/{replyId} {
          allow read: if true; // Anyone can read replies
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          // Allow update if: reply author (full edit) OR any authenticated user (only likes)
          allow update: if isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            onlyReplyLikesChanged()
          );
          // Allow delete if: reply author, parent comment author, or post author
          allow delete: if isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.userId == request.auth.uid ||
            get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
          );

          function onlyReplyLikesChanged() {
            let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
            return changedKeys.hasOnly(['likes']);
          }
        }
      }
    }

    

    match /admins/{userId} {
      // Permitir leer su propio documento O si es super admin
      allow read: if request.auth.uid == userId ||
                    (isAuthenticated() && request.auth.token.email == 'krux.app.info@gmail.com');
      // Permitir escribir solo al super admin
      allow write: if isAuthenticated() && request.auth.token.email == 'krux.app.info@gmail.com';
    }

    // ───────── Entrena: catálogo global de ejercicios ─────────
    // Cualquier usuario con sesión lee las fichas publicadas; solo admin y super-admin las crean,
    // editan o publican. Las colecciones de categorías y material son de solo lectura para usuarios.
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated() &&
        (resource.data.status == 'published' || isAdmin() || isSuperAdmin());
      allow create, update: if isAuthenticated() && (isAdmin() || isSuperAdmin())
        && exerciseId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.id == exerciseId
        && isString(request.resource.data.name, 100)
        && request.resource.data.status in ['draft', 'published', 'archived']
        && request.resource.data.schemaVersion == 1
        && request.resource.data.contentVersion is int
        && request.resource.data.contentVersion >= 1
        && isString(request.resource.data.primaryCategoryId, 40)
        && request.resource.data.review.status in ['pending', 'reviewed']
        && request.resource.data.instructions.executionSteps is list
        && request.resource.data.prescriptionSchema is list;
      allow delete: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    match /exercise_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    match /equipment/{equipmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    // Spotter requests collection
    match /spotter_requests/{requestId} {
      // Super admin can read ALL requests (needed for listing/querying)
      // Users can only read their own request
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && request.auth.uid == requestId);
      // Users can create their own request (requestId must be their uid)
      allow create: if isAuthenticated() &&
        request.auth.uid == requestId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Super admin can update (approve/reject), OR owner can resubmit (set back to pending)
      allow update: if isSuperAdmin() ||
        (isAuthenticated() &&
         request.auth.uid == requestId &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.status == 'pending');
      // No deletions allowed
      allow delete: if false;
    }

    // Sector images metadata
    match /sector_images/{imageId} {
      allow read: if true; // Anyone can read sector images metadata
      allow write: if isAuthenticated() && isAdmin(); // Only admins can upload/delete
    }

    // Route drawings on sector images
    match /sector_route_drawings/{drawingId} {
      allow read: if true; // Anyone can see route drawings
      allow write: if isAuthenticated() && isAdminOrSpotter(); // Admins and Spotters can draw routes
    }

    // Pending routes (vías pendientes de aprobación)
    match /pending_routes/{routeId} {
      // Permitir leer vías aprobadas a TODOS (incluso sin autenticación)
      // Permitir leer vías pendientes solo a admins/spotters
      allow read: if resource.data.status == 'approved' ||
        (isAuthenticated() && (isAdminOrSpotter() || isSuperAdmin()));
      // Admins y Spotters pueden crear vías pendientes
      allow create: if isAuthenticated() && isAdminOrSpotter();
      // Solo admins y super admin pueden aprobar/rechazar/eliminar
      allow update, delete: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    // Pending POI (puntos de interés pendientes de aprobación)
    match /pending_poi/{poiId} {
      allow read: if resource.data.status == 'approved' ||
        (isAuthenticated() && (isAdminOrSpotter() || isSuperAdmin()));
      allow create: if isAuthenticated() && isAdminOrSpotter();
      allow update, delete: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    // Pending sectors (sectores pendientes de aprobación)
    match /pending_sectors/{sectorId} {
      allow read: if resource.data.status == 'approved' ||
        (isAuthenticated() && (isAdminOrSpotter() || isSuperAdmin()));
      allow create: if isAuthenticated() && isAdminOrSpotter();
      allow update, delete: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    // Pending schools (escuelas pendientes de aprobación)
    match /pending_schools/{schoolId} {
      allow read: if resource.data.status == 'approved' ||
        (isAuthenticated() && (isAdminOrSpotter() || isSuperAdmin()));
      allow create: if isAuthenticated() && isAdminOrSpotter();
      allow update, delete: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    // Aleje votes (votaciones de aleje por ruta)
    match /aleje_votes/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Estado votes (votaciones de estado de la vía por ruta)
    match /estado_votes/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Grade votes (votaciones de grado por ruta)
    match /grade_votes/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Route suggestions (sugerencias de usuarios para información faltante de vías)
    match /routeSuggestions/{suggestionId} {
      // Admins pueden leer todas las sugerencias
      allow read: if isAuthenticated() && (isAdmin() || isSuperAdmin());
      // Cualquier usuario autenticado puede crear sugerencias
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Solo admins pueden aprobar/rechazar
      allow update, delete: if isAuthenticated() && (isAdmin() || isSuperAdmin());
    }

    // Helper function to check if user is super admin
    function isSuperAdmin() {
      return request.auth.token.email == 'krux.app.info@gmail.com';
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is spotter
    function isSpotter() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'spotter';
    }

    // Helper function to check if user is admin OR spotter
    function isAdminOrSpotter() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'spotter');
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return isAuthenticated() && request.auth.uid in resource.data.participants;
      }
      
      function willBeParticipant() {
        return isAuthenticated() && request.auth.uid in request.resource.data.participants;
      }

      allow read: if isParticipant();
      allow create: if willBeParticipant();
      allow update, delete: if isParticipant();

      match /messages/{messageId} {
        allow read, delete: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
